# PostgreSQL
POSTGRES_DB=whatsapp_web
POSTGRES_USER=wauser
POSTGRES_PASSWORD=wapassword
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://wauser:wapassword@localhost:5432/whatsapp_web
JWT_SECRET=change-me-in-production-please
JWT_EXPIRY_HOURS=24
REFRESH_TOKEN_EXPIRY_DAYS=7
RUST_LOG=info,whatsapp_web_backend=debug
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
CORS_ORIGINS=http://localhost:3000
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
SYNC_DAYS_LIMIT=90

# Webhook (Cakap / Chatwoot integration)
# Global fallback webhook URL; per-session config takes priority.
# Cakap format: https://your-cakap.example.com/webhooks/whatsapp_rust/{phone_number}
WEBHOOK_URL=
# Optional shared secret sent as X-Webhook-Token header
WEBHOOK_TOKEN=

# Frontend
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
