# =========================
# Root .gitignore for whatsapp-rust-web
# =========================

# --- Rust / Cargo ---
# Compiled artifacts
/target/
backend/target/

# Backup files from rustfmt
**/*.rs.bk

# Debugging information
*.pdb

# Cargo-mutants output
**/mutants.out*/

# --- Backend (Rust) ---
# WhatsApp session DB
backend/whatsapp.db

# Local DB files
backend/*.db
backend/*.db-shm
backend/*.db-wal

# --- Frontend (Node / Vite) ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Vite dev server cache
frontend/.vite/

# Cargo/local cache
.cargo/

# --- Playwright / Tests ---
test-results/
playwright-report/
coverage/

# --- IDEs / Editors ---
.vscode/
.idea/
*.iml

# Local History (JetBrains)
.idea/**/localHistory/

# --- OS files ---
.DS_Store
Thumbs.db

# --- Logs / env / temp ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local
*.tmp
*.bak

# --- Database files anywhere ---
*.db
*.db-shm
*.db-wal

# --- Misc ---
# Ignore build directories and editor swap files
**/dist-ssr/
*.swp
*.swo

# End of file